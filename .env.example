# Local Next.js development uses demo data unless this is true. These Supabase
# values are intentionally browser-visible; never use NEXT_PUBLIC_ for secrets.
NEXT_PUBLIC_USE_API=false
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Enable only providers configured in Supabase Auth. Email OTP requires SMTP.
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false
NEXT_PUBLIC_AUTH_APPLE_ENABLED=false
NEXT_PUBLIC_AUTH_EMAIL_OTP_ENABLED=true
# Optional. The iPhone app's page (https). The landing shows "Get the iPhone app"
# only when this is set.
# NEXT_PUBLIC_IOS_APP_URL=https://apps.apple.com/app/id0000000000

# Server-only values used by Next.js route handlers and the background worker.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_PUBLIC_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional Web Push. Keep this key pair stable across deployments.
VAPID_PUBLIC_KEY=your-base64url-public-key
VAPID_PRIVATE_KEY=your-base64url-private-key
VAPID_SUBJECT=https://peek.example.com

# Optional native iPhone notifications. These are Apple Developer server
# credentials; keep the complete .p8 private key on the server only. A value
# with literal \n line breaks is accepted by the worker.
APNS_TEAM_ID=your-apple-team-id
APNS_KEY_ID=your-apns-key-id
APNS_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nyour-key-material\n-----END PRIVATE KEY-----
APNS_BUNDLE_ID=com.plhery.SwissDeliveryTracker

# Optional. The iPhone apps that open parcel links and invitations, as
# <team id>.<bundle id> separated by commas. Defaults to the APNs app above.
# APPLE_APP_IDS=ABCDE12345.com.plhery.SwissDeliveryTracker

# Optional, for a site that moved: pages opened on a legacy host redirect to
# the same address on the canonical origin. APIs and assets stay where they are.
# With it, a production server also opens DPD's app session at start.
# CANONICAL_ORIGIN=https://peek.example.com
# LEGACY_HOSTS=delivery.example.com

# Optional: an email to an account when a parcel is ready to collect and when
# it is delivered, through any SMTP service. Needs CANONICAL_ORIGIN. Keep the daily numbers under the
# provider's allowance, which sign-in codes sent through it share.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-user
# SMTP_PASSWORD=your-password
# EMAIL_FROM=Peek <hello@example.com>
# EMAIL_REPLY_TO=help@example.com
# EMAIL_APPLE_RELAY=false
# DELIVERY_EMAILS_PER_ACCOUNT_PER_DAY=20
# DELIVERY_EMAILS_PER_DAY=80

# Private TRAWL browser endpoint. Mondial Relay uses it directly; UPS and DPD
# France use it when direct HTTP is challenged. DPD Switzerland uses it as its
# web fallback. Enable Redis in the TRAWL service (not this app) for Tier 2
# session reuse. See https://github.com/plhery/universal-parcel-scraper/blob/main/trawl/README.md for configuration and a live check.
FLARESOLVERR_URL=http://trawl:8191
# Postal Ninja / Ship24 form scrapers; Docker supplies Chromium automatically.
# For local runs, set this to a dedicated Chromium executable.
TRACKING_CHROMIUM_PATH=

# Optional Prometheus scrape endpoint for carrier telemetry (GET /api/metrics).
# Unset keeps the endpoint closed; the token (16+ characters) is sent as a
# bearer token by the Prometheus scraper. Labels carry carrier ids, step ids and
# error classes only, never tracking data.
METRICS_TOKEN=

# Optional server-only Sentry monitoring. Use a dedicated Peek
# project with restricted access. Reports keep tracking numbers (the
# tracking_number tag) and original error diagnostics, but not the failing
# request's body, query or client address. See docs/OBSERVABILITY.md before
# enabling this integration.
SENTRY_DSN=https://public-key@your-sentry-host/project-id
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=delivery-tracker@local
SENTRY_TRACES_SAMPLE_RATE=0
# Prefer the immutable 40-character image commit in production; it overrides
# SENTRY_RELEASE when present.
# IMAGE_COMMIT=0000000000000000000000000000000000000000

# Advanced DPD client override; normally leave commented and use the adapter's
# pinned public app identifier.
# DPD_FIREBASE_API_KEY=

PORT=3000
HOSTNAME=0.0.0.0

# Enable only when a trusted reverse proxy overwrites the forwarded client-IP
# headers before requests reach the container. Account limits remain primary.
TRUST_PROXY_HEADERS=false

# Optional. Parcels that can be looked up without an account per UTC day: per
# client address (which needs TRUST_PROXY_HEADERS=true; otherwise every visitor
# shares one allowance) and overall. 0 turns lookups off.
# PUBLIC_LOOKUPS_PER_DAY=15
# PUBLIC_LOOKUPS_GLOBAL_PER_DAY=3000

# Optional browser verification. Configure all three at runtime; the secret
# never enters a browser build. Use a Managed widget, without pre-clearance.
# TURNSTILE_SITE_KEY=your-site-key
# TURNSTILE_SECRET_KEY=your-server-secret
# TURNSTILE_HOSTNAMES=peek.example.com
# Optional compatibility exemption for the iPhone app's URLSession user-agent.
# This header can be forged; lookup budgets still apply.
# TURNSTILE_ALLOW_NATIVE_USER_AGENT=false
# ACCOUNT_LOOKUPS_PER_DAY=60
# ACCOUNT_DETECTIONS_PER_DAY=240

# Native verification. App Attest requires paid Apple Developer membership.
# Leave the app ID unset for the free Turnstile fallback.
# APP_ATTEST_APP_ID=TESTTEAM01.com.example.Peek
# APP_ATTEST_ALLOW_DEVELOPMENT=false
NATIVE_LOOKUPS_PER_DAY=15
NATIVE_DETECTIONS_PER_DAY=60


# Optional first-party Umami analytics. Runtime-only; leave all unset to disable.
# Both origins must be HTTPS origins without paths, queries or credentials.
# UMAMI_URL=https://analytics.example.com
# UMAMI_APP_ORIGIN=https://peek.example.com
# UMAMI_WEBSITE_ID=your-web-website-uuid
# UMAMI_IOS_WEBSITE_ID=your-ios-website-uuid
