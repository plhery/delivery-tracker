{
  "id": "sf-express",
  "displayName": "SF Express",
  "aliases": [],
  "region": {
    "countries": []
  },
  "brand": {
    "color": "#dc1e32"
  },
  "selectable": true,
  "timezone": "UTC",
  "tracking": {
    "mode": "automatic",
    "adapter": "sf-express",
    "steps": [
      "trawl"
    ]
  },
  "capabilities": [
    "history",
    "provider_code"
  ],
  "portal": {
    "url": "https://htm.sf-express.com/tw/en/dynamic_function/waybill/#search/bill-number/{trackingNumber}",
    "canaryUrl": "https://htm.sf-express.com/tw/en/dynamic_function/waybill/",
    "shows": [
      "status",
      "history"
    ],
    "scraped": [
      "status",
      "history",
      "provider_code"
    ],
    "discarded": [
      "proof_links",
      "contact_details",
      "facility_identifiers",
      "weight",
      "unverified_estimates"
    ],
    "unavailable": [
      "verified_scan_timezone"
    ]
  },
  "links": [
    {
      "domains": [
        "sf-express.com"
      ],
      "path": "^/.+/waybill-detail/([^/?#]+)/?$"
    },
    {
      "domains": [
        "htm.sf-express.com"
      ],
      "pathPattern": "^/tw/en/dynamic_function/waybill/$",
      "fragment": "^search/bill-number/(SF\\d{13}|\\d{12})$"
    }
  ],
  "detection": [
    {
      "id": "sf-express-1",
      "pattern": "^\\d{12}$",
      "confidence": "low"
    },
    {
      "id": "sf-express-2",
      "pattern": "^SF\\d{13}$",
      "confidence": "low"
    }
  ]
}
