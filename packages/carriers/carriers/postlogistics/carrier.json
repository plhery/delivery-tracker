{
  "id": "postlogistics",
  "displayName": "PostLogistics",
  "aliases": [],
  "region": {
    "countries": [
      "CH"
    ]
  },
  "brand": {
    "color": "#ffcc00",
    "family": "swiss-post"
  },
  "selectable": true,
  "timezone": "Europe/Zurich",
  "tracking": {
    "mode": "automatic",
    "adapter": "postlogistics",
    "steps": [
      "direct"
    ],
    "recognition": { "rank": 26 }
  },
  "capabilities": [
    "history",
    "location",
    "eta"
  ],
  "portal": {
    "url": "https://tracking.postlogistics.ch/public/trackandtrace/{trackingNumber}",
    "canaryUrl": "https://tracking.postlogistics.ch/public/trackandtrace",
    "shows": [
      "status",
      "history",
      "eta"
    ],
    "scraped": [
      "status",
      "history",
      "eta"
    ],
    "discarded": [],
    "unavailable": []
  },
  "links": [
    {
      "domains": ["tracking.postlogistics.ch"],
      "path": "^/public/trackandtrace/([^/?#]+)/?$"
    }
  ],
  "detection": [
    {
      "id": "postlogistics-dashed-reference",
      "pattern": "^\\d{11}$",
      "rawPattern": "^\\d{8}-\\d{3}$",
      "confidence": "high"
    },
    {
      "id": "postlogistics-compact-reference",
      "pattern": "^\\d{11}$",
      "confidence": "low"
    }
  ]
}
