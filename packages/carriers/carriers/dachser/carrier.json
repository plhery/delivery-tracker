{
  "id": "dachser",
  "displayName": "Dachser",
  "aliases": [
    "Dachser SE",
    "Dachser Customer Iberia"
  ],
  "region": {
    "countries": [
      "ES",
      "PT"
    ]
  },
  "brand": {
    "color": "#005ca9"
  },
  "selectable": true,
  "timezone": "Europe/Madrid",
  "tracking": {
    "mode": "automatic",
    "adapter": "dachser",
    "requirements": [
      {
        "field": "trackingUrl",
        "validator": "dachserCapabilityUrl",
        "label": "Dachser tracking URL",
        "type": "url",
        "placeholder": "https://customeriberia.dachser.com/customerarea/…",
        "help": "Paste the complete public detail link, including its access parameters."
      }
    ],
    "steps": [
      "direct"
    ]
  },
  "capabilities": [
    "history",
    "eta"
  ],
  "portal": {
    "canaryUrl": "https://customeriberia.dachser.com/customerarea/",
    "shows": [
      "status",
      "history",
      "eta",
      "sender_name",
      "recipient_name",
      "recipient_address",
      "recipient_contact",
      "signature"
    ],
    "scraped": [
      "status",
      "history",
      "eta"
    ],
    "discarded": [
      "sender_name",
      "recipient_name",
      "recipient_address",
      "recipient_contact",
      "signature"
    ],
    "unavailable": [
      "location"
    ]
  },
  "links": [
    {
      "domains": [
        "customeriberia.dachser.com"
      ],
      "params": [
        "numeroUnico"
      ],
      "keepsCapabilityUrl": true
    }
  ],
  "detection": []
}
