{
  "id": "swiss-post-cargo",
  "displayName": "Swiss Post Cargo",
  "aliases": [
    "Hugger"
  ],
  "region": {
    "countries": [
      "CH"
    ]
  },
  "brand": {
    "color": "#ffcc00",
    "family": "swiss-post"
  },
  "selectable": true,
  "timezone": "Europe/Zurich",
  "tracking": {
    "mode": "automatic",
    "adapter": "swiss-post-cargo",
    "steps": [
      "direct"
    ]
  },
  "capabilities": [
    "history",
    "location",
    "provider_code"
  ],
  "portal": {
    "url": "https://apv.swisspost-cargo.com/public/trackandtrace/{trackingNumber}",
    "canaryUrl": "https://apv.swisspost-cargo.com/public/trackandtrace",
    "shows": [
      "status",
      "history",
      "location",
      "recipient_name",
      "recipient_address"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "provider_code"
    ],
    "discarded": [
      "recipient_name",
      "recipient_address"
    ],
    "unavailable": []
  },
  "links": [
    {
      "domains": [
        "apv.swisspost-cargo.com"
      ],
      "path": "^/public/trackandtrace/([^/?#]+)/?$"
    }
  ],
  "detection": []
}
