{
  "id": "gls-fr",
  "displayName": "GLS France",
  "aliases": [
    "General Logistics Systems France"
  ],
  "region": {
    "countries": [
      "FR"
    ]
  },
  "brand": {
    "color": "#ffdd00",
    "family": "gls"
  },
  "selectable": true,
  "timezone": "Europe/Paris",
  "tracking": {
    "mode": "automatic",
    "adapter": "gls-fr",
    "steps": [
      "direct"
    ]
  },
  "capabilities": [
    "history",
    "location",
    "eta",
    "provider_code"
  ],
  "portal": {
    "url": "https://moncolis.gls-france.com/fr/{trackingNumber}",
    "canaryUrl": "https://moncolis.gls-france.com/fr/",
    "shows": [
      "status",
      "history",
      "location",
      "eta",
      "recipient_name",
      "recipient_address",
      "recipient_contact",
      "signature",
      "delivery_instructions"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "eta"
    ],
    "discarded": [
      "recipient_name",
      "recipient_address",
      "recipient_contact",
      "signature",
      "delivery_instructions"
    ],
    "unavailable": []
  },
  "links": [
    {
      "domains": [
        "moncolis.gls-france.com",
        "gls-france.com"
      ],
      "path": "^/fr/([^/?#]+)/?$"
    },
    {
      "domains": [
        "gls-group.com",
        "gls-group.eu"
      ],
      "params": [
        "match",
        "parcelNumber",
        "matchParcelNumber"
      ],
      "pathPattern": "^/FR/"
    }
  ],
  "detection": [
    {
      "id": "gls-fr-1",
      "pattern": "^00(?=[A-Z0-9]{6}$)(?=.*[A-Z])(?=.*\\d)[A-Z0-9]{6}$",
      "confidence": "high"
    },
    {
      "id": "gls-fr-2",
      "pattern": "^(?=[A-Z0-9]{8}$)(?=.*[A-Z])(?=.*\\d)[A-Z0-9]{8}$",
      "confidence": "low"
    },
    {
      "id": "gls-fr-3",
      "pattern": "^\\d{11,12}$",
      "confidence": "low"
    }
  ]
}
