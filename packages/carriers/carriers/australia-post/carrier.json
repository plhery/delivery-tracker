{
  "id": "australia-post",
  "displayName": "Australia Post",
  "aliases": [],
  "region": {
    "countries": []
  },
  "brand": {
    "color": "#dc1928"
  },
  "selectable": true,
  "timezone": "UTC",
  "tracking": {
    "mode": "automatic",
    "adapter": "australia-post",
    "steps": [
      "trawl"
    ]
  },
  "capabilities": [
    "history",
    "location",
    "provider_code",
    "delivered_at"
  ],
  "portal": {
    "url": "https://auspost.com.au/mypost/track/details/{trackingNumber}",
    "canaryUrl": "https://auspost.com.au/mypost/track/",
    "shows": [
      "status",
      "history",
      "location",
      "provider_code",
      "delivered_at",
      "recipient_name",
      "address",
      "delivery_proof"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "provider_code",
      "delivered_at"
    ],
    "discarded": [
      "recipient_name",
      "address",
      "delivery_proof"
    ],
    "unavailable": []
  },
  "links": [
    {
      "domains": [
        "auspost.com.au"
      ],
      "params": [
        "id"
      ]
    },
    {
      "domains": [
        "auspost.com.au"
      ],
      "path": "^/mypost/track/details/([^/?#]+)/?$"
    }
  ],
  "detection": []
}
