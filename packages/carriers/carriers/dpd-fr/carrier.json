{
  "id": "dpd-fr",
  "displayName": "DPD France",
  "aliases": [
    "Exapaq"
  ],
  "region": {
    "countries": [
      "FR"
    ]
  },
  "brand": {
    "color": "#dc0032",
    "family": "dpd"
  },
  "selectable": true,
  "timezone": "Europe/Paris",
  "tracking": {
    "mode": "automatic",
    "adapter": "dpd-france",
    "steps": [
      "direct",
      "trawl"
    ]
  },
  "capabilities": [
    "history",
    "location",
    "eta"
  ],
  "portal": {
    "url": "https://trace.dpd.fr/fr/trace/{trackingNumber}",
    "canaryUrl": "https://trace.dpd.fr/fr/trace",
    "shows": [
      "status",
      "history",
      "location",
      "eta",
      "recipient_name",
      "recipient_address",
      "signature",
      "customer_reference"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "eta"
    ],
    "discarded": [
      "recipient_name",
      "recipient_address",
      "signature",
      "customer_reference"
    ],
    "unavailable": []
  },
  "links": [
    {
      "domains": [
        "trace.dpd.fr"
      ],
      "path": "^/(?:fr/trace|trace-particuliers)/([^/?#]+)/?$"
    }
  ],
  "detection": [
    {
      "id": "dpd-fr-1",
      "pattern": "^250\\d{12}$",
      "confidence": "high"
    },
    {
      "id": "dpd-fr-2",
      "pattern": "^(?:[01]\\d{11,14}|250\\d{9,11})$",
      "confidence": "low"
    }
  ]
}
