{
  "id": "paack",
  "displayName": "Paack",
  "aliases": [
    "Paack Logistics"
  ],
  "region": {
    "countries": [
      "ES",
      "PT",
      "FR",
      "GB"
    ]
  },
  "brand": {
    "color": "#5b2dee"
  },
  "selectable": true,
  "timezone": "Europe/Paris",
  "tracking": {
    "mode": "automatic",
    "adapter": "paack",
    "requirements": [
      {
        "field": "dpdPostcode",
        "validator": "paackPostcode",
        "label": "Delivery postcode",
        "type": "text",
        "placeholder": "75001",
        "help": "Paack requires the recipient postcode together with the order number.",
        "pattern": "^(?=.{3,10}$)(?=.*[0-9])[A-Za-z0-9]+(?:[ -][A-Za-z0-9]+)*$",
        "maxLength": 10,
        "inputMode": "text",
        "autoComplete": "postal-code"
      }
    ],
    "steps": [
      "direct"
    ]
  },
  "capabilities": [
    "history",
    "eta"
  ],
  "portal": {
    "url": "https://mydeliveries.paack.app/tracking?tracking_number={trackingNumber}",
    "canaryUrl": "https://mydeliveries.paack.app/tracking",
    "shows": [
      "status",
      "history",
      "eta",
      "sender_name",
      "recipient_name",
      "recipient_address"
    ],
    "scraped": [
      "status",
      "history",
      "eta"
    ],
    "discarded": [
      "sender_name",
      "recipient_name",
      "recipient_address"
    ],
    "unavailable": []
  },
  "links": [
    {
      "domains": [
        "mydeliveries.paack.app"
      ],
      "params": [
        "tracking_number"
      ]
    }
  ],
  "detection": []
}
