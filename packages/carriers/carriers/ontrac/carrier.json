      "history",
      "estimated_delivery",
      "weight"
    ],
    "scraped": [
      "status",
      "history",
      "estimated_delivery",
      "weight"
    ],
    "discarded": [
      "recipient",
      "signature"
    ],
    "unavailable": []
  },
  "links": [
    {
      "domains": [
        "ontrac.com"
      ],
      "params": [
        "number"
      ]
    }
  ],
  "detection": [
    {
      "id": "ontrac-1",
      "pattern": "^[CD]\\d{14}$",
      "confidence": "high"
    },
    {
      "id": "ontrac-2",
      "pattern": "^L[AIEHNX]\\d{8}$",
      "confidence": "high"
    },
    {
      "id": "ontrac-3",
      "pattern": "^1LS\\d{12,14}$",
      "confidence": "high"
    },
    {
      "id": "ontrac-4",
      "pattern": "^1LS[A-Z0-9]{12,14}$",
      "confidence": "high"
    }
  ]
