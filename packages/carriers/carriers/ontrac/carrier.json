{
  "id": "ontrac",
  "displayName": "OnTrac",
  "aliases": [],
  "region": {
    "countries": []
  },
  "brand": {
    "color": "#cc2027"
  },
  "selectable": true,
  "timezone": "UTC",
  "tracking": {
    "mode": "automatic",
    "adapter": "ontrac",
    "steps": [
      "direct"
    ]
  },
  "capabilities": [
