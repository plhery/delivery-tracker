{
  "id": "hermes-de",
  "displayName": "Hermes Germany",
  "aliases": [
    "myHermes",
    "Hermes Germany GmbH"
  ],
  "region": {
    "countries": [
      "DE"
    ]
  },
  "brand": {
    "color": "#0091cd"
  },
  "selectable": true,
  "timezone": "Europe/Berlin",
  "tracking": {
    "mode": "automatic",
    "adapter": "hermes-de",
    "steps": [
      "direct"
    ]
  },
  "capabilities": [
    "history",
    "eta",
    "sender_name",
    "delivered_at",
    "provider_code"
  ],
  "portal": {
    "url": "https://www.myhermes.de/empfangen/sendungsverfolgung/sendungsinformation#{trackingNumber}",
    "canaryUrl": "https://www.myhermes.de/empfangen/sendungsverfolgung/",
    "shows": [
      "status",
      "history",
      "eta",
      "sender_name",
      "recipient_name",
      "recipient_address",
      "delivery_instructions"
    ],
    "scraped": [
      "status",
      "history",
      "eta",
      "sender_name",
      "delivered_at",
      "provider_code"
    ],
    "discarded": [
      "recipient_name",
      "recipient_address",
      "delivery_instructions"
    ],
    "unavailable": [
      "location"
    ]
  },
  "links": [
    {
      "domains": [
        "myhermes.de"
      ],
      "params": [
        "TrackID",
        "trackingNumber",
        "sendungsId"
      ],
      "fragment": "^([A-Z0-9]{8,20})(?:$|[?&])"
    }
  ],
  "detection": [
    {
      "id": "hermes-de-1",
      "pattern": "^H\\d{15,19}$",
      "confidence": "high"
    },
    {
      "id": "hermes-de-2",
      "pattern": "^\\d{14}$",
      "confidence": "low"
    }
  ]
}
