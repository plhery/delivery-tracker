{
  "id": "asendia",
  "displayName": "Asendia",
  "aliases": [
    "Asendia Management",
    "Asendia UK",
    "asendia.com"
  ],
  "region": {
    "countries": [
      "FR",
      "CH",
      "GB",
      "DE",
      "US"
    ]
  },
  "brand": {
    "color": "#ef7d00"
  },
  "selectable": true,
  "timezone": "UTC",
  "tracking": {
    "mode": "automatic",
    "adapter": "asendia",
    "steps": [
      "direct"
    ]
  },
  "capabilities": [
    "history",
    "location",
    "provider_code",
    "weight"
  ],
  "portal": {
    "url": "https://track.asendia.com/track/{trackingNumber}",
    "canaryUrl": "https://a1.asendiausa.com/tracking/",
    "shows": [
      "status",
      "history",
      "location",
      "weight"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "weight"
    ],
    "discarded": [],
    "unavailable": [
      "eta"
    ]
  },
  "links": [
    {
      "domains": [
        "track.asendia.com"
      ],
      "path": "^/track/([^/?#]+)/?$"
    },
    {
      "domains": [
        "a1.asendiausa.com",
        "a1.asendia.com"
      ],
      "pathPattern": "^/tracking/?$",
      "params": [
        "trackingnumber"
      ]
    }
  ],
  "detection": [
    {
      "id": "asendia-1",
      "pattern": "^ASE[A-Z0-9]{8,37}$",
      "confidence": "high"
    },
    {
      "id": "asendia-2",
      "pattern": "^AS\\d{9}US$",
      "confidence": "high"
    },
    {
      "id": "asendia-3",
      "pattern": "^AHOY[A-Z0-9]{8}$",
      "confidence": "high"
    }
  ]
}
