{
  "name": "swiss-delivery-tracker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "An open-source native iPhone app and PWA for following parcel deliveries.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plhery/delivery-tracker.git"
  },
  "bugs": {
    "url": "https://github.com/plhery/delivery-tracker/issues"
  },
  "homepage": "https://github.com/plhery/delivery-tracker#readme",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "npm": ">=10"
  },
  "overrides": {
    "browserslist": "4.28.8"
  },
  "scripts": {
    "carrier:new": "node packages/carriers/scripts/new-carrier.mjs",
    "contract:generate": "node scripts/generate-api-contract.mjs && node packages/carriers/scripts/generate-registry.mjs && node packages/carriers/scripts/generate-brand.mjs",
    "dev": "next dev --webpack",
    "build": "next build --webpack && node scripts/prepare-standalone.mjs",
    "canary": "node --experimental-strip-types src/server/carrierCanary.ts",
    "start": "node .next/standalone/server.js",
    "preview": "npm run start",
    "test": "vitest run",
    "test:carriers:live": "vitest run --config vitest.carriers-live.config.ts",
    "test:tracking-links": "vitest run --config vitest.carriers-live.config.ts src/server/trackingLinks.live.test.ts",
    "test:scripts": "node --test ops/trawl/tracking-capture.test.mjs scripts/native-localization.test.mjs scripts/prepare-personal-ios-project.test.mjs scripts/validate-production-config.test.mjs scripts/smoke-url.test.mjs scripts/validate-ios-install.test.mjs",
    "test:contract": "node scripts/generate-api-contract.mjs --check && node packages/carriers/scripts/generate-registry.mjs --check && node packages/carriers/scripts/generate-brand.mjs --check",
    "test:coverage": "vitest run --coverage",
    "test:coverage:server": "vitest run --config vitest.server.config.ts --coverage",
    "test:e2e": "playwright test",
    "test:dev": "node scripts/test-dev-startup.mjs",
    "test:deployment": "node scripts/test-deployment-recovery.mjs",
    "test:pwa": "node scripts/test-pwa-build.mjs",
    "test:watch": "vitest",
    "icons": "node scripts/generate-icons.mjs",
    "ios:resources": "node scripts/generate-ios-resources.mjs",
    "lint": "eslint . --max-warnings=0",
    "lint:frontend": "npm run lint",
    "typecheck": "tsc --noEmit",
    "validate:production-config": "node scripts/validate-production-config.mjs"
  },
  "dependencies": {
    "@sentry/node": "^10.72.0",
    "@serwist/next": "^9.5.12",
    "@supabase/supabase-js": "^2.112.1",
    "cheerio": "^1.2.0",
    "fetch-cookie": "^3.1.0",
    "jose": "^6.2.10",
    "luxon": "^3.7.2",
    "next": "^16.3.4",
    "playwright-core": "1.62.1",
    "prom-client": "^15.1.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "serwist": "^9.5.12",
    "tough-cookie": "^6.0.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/luxon": "^3.7.5",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^4.1.10",
    "ajv": "^8.20.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
