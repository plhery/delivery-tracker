{
  "name": "peek-delivery-tracker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "An open-source native iPhone app and PWA for following parcel deliveries.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plhery/peek-delivery-tracker.git"
  },
  "bugs": {
    "url": "https://github.com/plhery/peek-delivery-tracker/issues"
  },
  "homepage": "https://github.com/plhery/peek-delivery-tracker#readme",
  "engines": {
    "node": ">=26.5.1",
    "npm": ">=10"
  },
  "overrides": {
    "browserslist": "4.29.3"
  },
  "scripts": {
    "contract:generate": "node scripts/generate-api-contract.mjs && node scripts/generate-brand.mjs",
    "dev": "next dev",
    "build": "next build && node scripts/build-service-worker.mjs && node scripts/prepare-standalone.mjs",
    "start": "node .next/standalone/server.js",
    "preview": "npm run start",
    "test": "vitest run && vitest run --config vitest.server.config.ts",
    "test:scripts": "node --test scripts/native-localization.test.mjs scripts/prepare-personal-ios-project.test.mjs scripts/validate-production-config.test.mjs scripts/smoke-url.test.mjs scripts/validate-ios-install.test.mjs scripts/generate-privacy.test.mjs scripts/adopt-scraper.test.mjs scripts/ci-changes.test.mjs scripts/ci-workflow.test.mjs scripts/deploy-gate.test.mjs",
    "test:contract": "node scripts/generate-api-contract.mjs --check && node scripts/generate-brand.mjs --check",
    "test:coverage": "vitest run --coverage",
    "test:coverage:server": "vitest run --config vitest.server.config.ts --coverage",
    "test:e2e": "playwright test",
    "test:dev": "node scripts/test-dev-startup.mjs",
    "test:deployment": "node scripts/test-deployment-recovery.mjs",
    "test:pwa": "node scripts/test-pwa-build.mjs",
    "test:watch": "vitest",
    "icons": "node scripts/generate-icons.mjs",
    "privacy": "node scripts/generate-privacy.mjs",
    "ios:resources": "node scripts/generate-ios-resources.mjs",
    "lint": "eslint . --max-warnings=0",
    "lint:frontend": "npm run lint",
    "typecheck": "tsc --noEmit",
    "validate:production-config": "node scripts/validate-production-config.mjs"
  },
  "dependencies": {
    "@prometheus-io/client": "^0.16.1",
    "@sentry/node": "^11.5.0",
    "@serwist/next": "^9.5.13",
    "@supabase/auth-js": "^2.117.3",
    "cbor": "10.0.12",
    "d3-geo": "^3.1.1",
    "jose": "^6.2.12",
    "luxon": "^3.7.2",
    "next": "^16.4.0",
    "node-app-attest": "1.0.1",
    "nodemailer": "^10.0.16",
    "onnxruntime-web": "1.30.0",
    "playwright-core": "1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "serwist": "^9.5.13",
    "sharp": "0.35.5",
    "universal-parcel-scraper": "0.49.0-main.548",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@resvg/resvg-js": "^2.6.2",
    "@serwist/build": "^9.5.13",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/d3-geo": "^3.1.1",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.0.3",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "jsdom": "^30.1.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
